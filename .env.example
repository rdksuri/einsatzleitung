PORT=3000

# Geteiltes PIN fuer den Login (frei waehlbar, z.B. 4-6-stellige Zahl)
EINSATZ_PIN=changeme

# Zufaelliger, langer Secret-String zum Signieren der Login-Tokens
# z.B. erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme

# Optional: Pfad zur SQLite-Datenbankdatei
# DB_PATH=./data/einsatzleitung.db
